# Copy to build.env and edit. build.env is the ONLY place that points at your
# local NCS workspace, so the firmware itself stays project-independent.
# tools/flash.command and tools/flash_usb.command both source it if present.

# NCS west workspace (dir containing .west/ zephyr/ nrf/ ncs-venv/).
#
# A shared/global workspace is fine — this project needs the same NCS revision
# as FindMyTag, JAVELYTICS and RideFormTracker, so pointing them all at one
# checkout saves several GB:
NCS_ROOT="$HOME/ncs/eggdrop"

# Zephyr SDK / toolchain (installed once, shared by every project).
ZEPHYR_SDK_INSTALL_DIR="$HOME/zephyr-sdk-0.17.0"

# Board target and debug probe target.
#
#   cadence_v1   the real PCB (KiCad/BikeSensor, 15x33 mm)
#   cadence_rft  the RideFormTracker board the firmware was brought up on
#
# They differ only in DTS (LEDs, and v1's soft power latch); src/ is shared.
BOARD="cadence_v1"
PYOCD_TARGET="nrf52840"
